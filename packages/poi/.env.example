NODE_ENV=production
PPOI_MODE=ofac
CHAIN_ID=1
START_BLOCK=0
RPC_URLS=https://rpc-1.example,https://rpc-2.example
VAULT_ADDRESS=0x...
PPOI_LIST_PRIVATE_KEY=replace-with-a-dedicated-32-byte-hex-secret
PPOI_VKEY=../contracts/build/circuits/swirl_poi_verification_key.json
PPOI_STATE_FILE=./poi-state-1.json
CORS_ORIGIN=https://your-relayer.example
HOST=127.0.0.1
PORT=8790

# OFAC SDN_ADVANCED: check at startup and every 24 hours.
# Only the current compact address cache is retained. Raw archives and
# program-owned stale temporary files are not retained.
OFAC_CACHE_FILE=./ofac-addresses-1.json

# PublicAML v2 is required by default; failures leave shields Pending.
PUBLICAML_ENABLED=true
PUBLICAML_TIMEOUT_MS=8000
# Optional: also block non-sanction risk scores at or above this value (0-100).
# Leave unset to block direct sanctions without blocking on indirect risk alone.
# PUBLICAML_BLOCK_SCORE=90

SHIELD_PENDING_SECONDS=3600
LOG_BATCH_SIZE=500
CONFIRMATIONS=1
