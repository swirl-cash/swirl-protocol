{
  "manifest_version": 3,
  "name": "SWIRL Wallet",
  "version": "0.7.7",
  "description": "Private SWIRL wallet with Groth16 proofs, multiple EVM networks and user-approved dApp connections.",
  "permissions": ["storage"],
  "host_permissions": ["https://swirl.cash/*", "https://www.swirl.cash/*", "https://relay.swirl.cash/*", "http://127.0.0.1/*", "http://localhost/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://swirl.cash/*", "https://www.swirl.cash/*", "http://127.0.0.1/*", "http://localhost/*"],
      "js": ["inpage.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["https://swirl.cash/*", "https://www.swirl.cash/*", "http://127.0.0.1/*", "http://localhost/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_title": "Open SWIRL Wallet",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https: http://127.0.0.1:* http://localhost:*"
  }
}
